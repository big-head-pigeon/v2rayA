# v2rayA v2.5.8 with transparent-proxy inbound listening on 0.0.0.0
# (restores docker/bridge container coverage, like 2.2.7.5 did)
#
# Build only the patched v2raya binary from source (GUI -> embedded web -> Go),
# then overlay it on the stock official image so the runtime environment
# (iptables wrappers, nftables, v2raya_core, geodata) stays 100% identical
# to the official v2.5.8 release.

FROM node:24-alpine AS gui
WORKDIR /build
COPY gui/package.json gui/yarn.lock ./gui/
RUN yarn --cwd gui --check-files --frozen-lockfile || yarn --cwd gui --check-files
COPY gui ./gui
RUN yarn --cwd gui build

FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY service/go.mod service/go.sum ./service/
RUN cd service && go mod download
COPY service ./service
COPY --from=gui /build/web /src/web
RUN rm -rf service/server/router/web && mkdir -p service/server/router/web \
    && cp -a web/. service/server/router/web/ \
    && cd service && CGO_ENABLED=0 go build -trimpath -o /out/v2raya \
       -ldflags="-X github.com/v2rayA/v2rayA/conf.Version=v2.5.8 -s -w"

FROM ghcr.io/v2raya/v2raya:v2.5.8
COPY --from=builder /out/v2raya /usr/bin/v2raya
